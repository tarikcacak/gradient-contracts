# Uniswap V2 router on Sepolia.
#
# VERIFY THIS BEFORE USING IT. The addresses circulating in docs and tutorials
# contradict each other; several are dead or belong to forks.
#
#   cast call $UNISWAP_V2_ROUTER "factory()(address)" --rpc-url $SEPOLIA_RPC_URL
#   cast call $UNISWAP_V2_ROUTER "WETH()(address)"    --rpc-url $SEPOLIA_RPC_URL
#   cast code $UNISWAP_V2_ROUTER --rpc-url $SEPOLIA_RPC_URL | wc -c
#
# Safest option: deploy your own UniswapV2Factory + Router02 to Sepolia from the
# canonical sources and point this at yours. Free ETH, one fewer dependency, and
# fork tests share one address set with production. If you do, make sure the
# router's hardcoded init code hash matches your factory's pair bytecode - that
# mismatch is the classic self-deploy failure.
UNISWAP_V2_ROUTER=0x7dd71144B1AC592a0d1DcD18195E0e2e6B8B8bE0

# ---------------------------------------------------------------- optional
TREASURY=0xc6f993dBF783Bc0990b59bA63Ea2B99c8cf5073a
VIRTUAL_ETH_START=125000000000000000 # 0.125 ETH -> a 0.5 ETH raise (4x the seed)
CREATE_FEE=100000000000000           # 0.0001 ETH anti-spam fee

# --------------------------------------------------- filled in after deploy
CURVE_ADDRESS=
FACTORY_ADDRESS=
DEPLOY_BLOCK=
